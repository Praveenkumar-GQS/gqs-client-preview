function onPdfUpload(input){
  if(!input.files||!input.files[0]) return;
  const file=input.files[0];
  if(file.type!=='application/pdf'){ alert('Please upload a PDF file.'); return; }
  document.getElementById('pdfChosenName').textContent=file.name;
  document.getElementById('pdfChosenName').style.display='block';
  document.getElementById('pdfIcon').style.display='none';
  document.getElementById('pdfText').style.display='none';
  document.getElementById('pdfSub').style.display='none';
  document.getElementById('pdfClear').style.display='block';
  document.getElementById('pdfBox').style.borderColor='#1a3a5c';
  document.getElementById('pdfBox').style.background='#fff';
  pdfUploaded=true;
}

