function fmtDDMMYYYYtoLabel(d){
  if(!d) return '';
  var parts=d.split('/');
  var months=['Jan','Feb','Mar','Apr','May','Jun','Jul','Aug','Sep','Oct','Nov','Dec'];
  return parts[0]+'-'+months[parseInt(parts[1],10)-1]+'-'+parts[2];
}

(function computeTotals(){
  if(!ROWS || !ROWS.length) return;
  var tV=ROWS.length;
  var tW=0,tT=0,tR=0,tO=0,tM=0;
  ROWS.forEach(function(r){tW+=r.wt;tT+=r.tt;tR+=r.rt;tO+=r.ot;tM+=r.mileage;});
  var tH=tW+tT+tR+tO;
  var minDate=ROWS[ROWS.length-1].start;
  var maxDate=ROWS[0].end;
  var periodLabel=fmtDDMMYYYYtoLabel(minDate)+' to '+fmtDDMMYYYYtoLabel(maxDate);

  document.getElementById('sumTotalVisits').textContent=tV;
  document.getElementById('sumVisitPeriod').textContent=periodLabel;
  document.getElementById('metaTotalVisits').textContent=tV;
  document.getElementById('tfootSummary').innerHTML='Total Visits: '+tV+' &nbsp;&nbsp;&nbsp; Total Mileage: '+tM+' km &nbsp;&nbsp;&nbsp; Prepared for consolidated client approval';
  document.getElementById('tfWork').textContent=tW;
  document.getElementById('tfTravel').textContent=tT;
  document.getElementById('tfReport').textContent=tR;
  document.getElementById('tfOT').textContent=tO;
  document.getElementById('tfHours').textContent=tH;
  document.getElementById('tfMileage').textContent=tM;
  document.getElementById('barVisits').textContent=tV;
  document.getElementById('barHours').textContent=tH;
  document.getElementById('barWork').textContent=tW;
  document.getElementById('barTravel').textContent=tT;
  document.getElementById('barReport').textContent=tR;
  document.getElementById('barOT').textContent=tO;
  document.getElementById('barMileage').textContent=tM+' km';
})();

