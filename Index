function doSubmit(){
  const date=document.getElementById('approvalDate').value;
  const comments=document.getElementById('approvalComments').value;
  if(currentSignMethod==='upload' && !sigUploaded){ alert('Please upload your signature before submitting.'); return; }
  if(currentSignMethod==='pdf' && !pdfUploaded){ alert('Please upload the signed PDF before submitting.'); return; }
  if(!date){ alert('Please select an approval date.'); return; }

  const btn=document.getElementById('btnSubmit');
  const rejBtn=document.getElementById('btnReject');
  btn.disabled=true;
  rejBtn.disabled=true;
  btn.innerHTML='&#8987; Submitting...';

  setTimeout(()=>{
    document.getElementById('approvalCard').style.display='none';
    const ss=document.getElementById('successScreen');
    ss.classList.remove('rejected');
    ss.classList.add('show');
    document.getElementById('doneIcon').innerHTML='&#9989;';
    document.getElementById('doneTitle').textContent='Timesheet Approved!';
    document.getElementById('doneSub').textContent='Your approval has been submitted successfully. The GQS coordinator has been notified.';
    document.getElementById('doneApprovedByRow').style.display='';
    document.getElementById('doneApprovedBy').textContent='Client Representative';
    document.getElementById('doneDate').textContent=date;
    document.getElementById('doneTime').textContent=new Date().toLocaleString('en-GB');
    if(comments){
      document.getElementById('doneCommentsRow').style.display='';
      document.getElementById('doneComments').textContent=comments;
    }
    const pill=document.getElementById('statusPill');
    pill.textContent='Approved';
    pill.classList.remove('rejected');
    pill.classList.add('submitted');
    window.scrollTo({top:0,behavior:'smooth'});
  }, 1400);
}

function doReject(){
  const date=document.getElementById('approvalDate').value;
  const comments=document.getElementById('approvalComments').value;
  if(!date){ alert('Please select a date.'); return; }
  if(!comments){ alert('Please provide a reason for rejection in Comments.'); return; }
  if(!confirm('Are you sure you want to reject this timesheet?')) return;

  const btn=document.getElementById('btnSubmit');
  const rejBtn=document.getElementById('btnReject');
  btn.disabled=true;
  rejBtn.disabled=true;
  rejBtn.innerHTML='&#8987; Rejecting...';

  setTimeout(()=>{
    document.getElementById('approvalCard').style.display='none';
    const ss=document.getElementById('successScreen');
    ss.classList.add('show');
    ss.classList.add('rejected');
    document.getElementById('doneIcon').innerHTML='&#10060;';
    document.getElementById('doneTitle').textContent='Timesheet Rejected';
    document.getElementById('doneSub').textContent='Your rejection has been submitted. The GQS coordinator has been notified and will follow up.';
    document.getElementById('doneApprovedByRow').style.display='none';
    document.getElementById('doneDate').textContent=date;
    document.getElementById('doneTime').textContent=new Date().toLocaleString('en-GB');
    document.getElementById('doneCommentsRow').style.display='';
    document.getElementById('doneComments').textContent=comments;
    const pill=document.getElementById('statusPill');
    pill.textContent='Rejected';
    pill.classList.remove('submitted');
    pill.classList.add('rejected');
    window.scrollTo({top:0,behavior:'smooth'});
  }, 1400);
}

